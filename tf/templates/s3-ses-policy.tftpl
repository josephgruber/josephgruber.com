{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ses.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::${bucket}/*",
            "Condition": {
                "StringEquals": {
                    "aws:Referer": "${account_id}"
                }
            }
        }
    ]
}
